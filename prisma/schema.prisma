generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Listing {
  id        String   @id @default(cuid())
  title     String
  price     Float
  url       String
  lat       Float
  lng       Float
  source    String
  imageUrl  String?
  createdAt DateTime @default(now())
}
